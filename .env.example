# Copie para .env na raiz (opcional) antes de: docker compose up --build -d
NGS_JWT_SECRET=change-me-ngs-analytics-platform-jwt-secret-key-32bytes-min
# true = sem login (usuário dev criado automaticamente); false = exige registro/login
NGS_AUTH_DISABLED=true
# Docker defaults: analyst on, Ollama on the host (optional).
# NGS_AI_ENABLED=true
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.2

# Optional with compose.override.yaml (local dump, not in git):
# GENOMETRICS_DUMP_HOST=/home/you/projetos/dumps/genometrics/demo-data.sql
