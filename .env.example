# Optional: copy to .env at the repo root and export it before `mvn spring-boot:run`.
NGS_JWT_SECRET=change-me-ngs-analytics-platform-jwt-secret-key-32bytes-min
# true = sem login (usuário dev criado automaticamente); false = exige registro/login
NGS_AUTH_DISABLED=true
# Optional local LLM for explain_qc (off by default; falls back to grounded facts if unreachable).
# Do not expose Ollama on 0.0.0.0 on untrusted networks; see docs/mcp.md.
# NGS_AI_ENABLED=true
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
